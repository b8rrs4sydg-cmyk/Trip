{
  "name": "family-trip",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-trip-db"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  }
}
